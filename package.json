{
  "name": "infinite-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start:app": "turbo run start --filter=@infinite-canvas/app",
    "build:app": "turbo run build --filter=@infinite-canvas/app",
    "test:app": "turbo run test --filter=@infinite-canvas/app",
    "eject:app": "npm run eject --workspace=app"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "workspaces": [
    "app",
    "hooks",
    "lib/*",
    "utils"
  ]
}